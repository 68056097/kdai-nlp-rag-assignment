# คัดลอกเป็น .env แล้ว export ก่อนรัน (ห้าม commit .env ขึ้น GitHub)
OPENROUTER_API_KEY=sk-or-xxxxxxxx
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200

# ---- ปุ่มสำหรับทำ ablation (ปิด/เปิดทีละเทคนิค) ----
# USE_CONTEXT=1          # สร้าง context ด้วย LLM จากเอกสารเต็ม
# USE_RERANK=1           # cross-encoder reranker
# EXPAND_NEIGHBORS=1     # ต่อ chunk ข้างเคียง
# CHUNK_MAX_CHARS=700
# CHUNK_OVERLAP_CHARS=120
# CANDIDATES=30
# RERANK_TOP_N=5
# RERANK_MIN_SCORE=0.05
# WEIGHT_SPARSE=1.0
# WEIGHT_DENSE=1.0
